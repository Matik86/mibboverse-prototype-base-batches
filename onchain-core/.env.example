# ==========================================
# DEPLOYMENT PRIVATE KEY
# ==========================================
PRIVATE_KEY=""

# ==========================================
# RPC URLs
# ==========================================
# Use a monitored provider for production deployments; public Base endpoints are rate-limited.
BASE_MAINNET_RPC_URL=""
# Optional testnet endpoint for explicit development deployments only.
BASE_SEPOLIA_RPC_URL=""

# ==========================================
# IGNITION PARAMETERS
# ==========================================
# Official ERC-8004 Identity Registry proxy on Base mainnet.
# Never reuse the Base Sepolia address here.
ERC8004_ADDRESS=""

# Dedicated backend relayer that will report MibboPass recordUsage on Base mainnet.
# The module still supports a deployer fallback for local development.
INITIAL_RELAYER=""

# Existing MibboRegistry used by ignition/modules/MibboPass.ts when only the
# Pass contract must be deployed without replacing Registry or Treasury.
MIBBO_REGISTRY_ADDRESS=""

# Required only when deploying the standalone MibboSettlement module.
SETTLEMENT_TOKEN_ADDRESS=""
SETTLEMENT_TREASURY_ADDRESS=""
SETTLEMENT_OWNER_ADDRESS=""
SETTLEMENT_RELAYER_ADDRESS=""

# Your ethersca API key
ETHERSCAN_API_KEY=""
